{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://csswitch.local/schema/evidence-manifest.v1.schema.json",
  "title": "Evidence manifest v1",
  "$defs": {
    "RunId": {"type": "string", "pattern": "^[0-9a-f]{32}(?![\\s\\S])", "minLength": 32, "maxLength": 32},
    "Sha": {"type": "string", "pattern": "^[0-9a-f]{64}(?![\\s\\S])", "minLength": 64, "maxLength": 64},
    "Path": {"type": "string", "pattern": "^(?!/)(?!.*[\\u0000-\\u001f\\u007f])(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))(?!.*(?:^|/)(?:/|$)).{1,240}$(?![\\s\\S])", "minLength": 1, "maxLength": 240},
    "ArtifactRef": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"$ref": "#/$defs/Path"}, "sha256": {"$ref": "#/$defs/Sha"}}},
    "ResultRef": {"type": "object", "additionalProperties": false, "required": ["suite_id", "entrypoint_id", "path", "sha256"], "properties": {"suite_id": {"type": "string", "pattern": "^SUITE-[A-Z0-9][A-Z0-9-]{0,31}(?![\\s\\S])", "maxLength": 38}, "entrypoint_id": {"type": "string", "pattern": "^ENTRY-[A-Z0-9][A-Z0-9-]{0,31}(?![\\s\\S])", "maxLength": 38}, "path": {"$ref": "#/$defs/Path"}, "sha256": {"$ref": "#/$defs/Sha"}}},
    "ObservationRef": {"type": "object", "additionalProperties": false, "required": ["suite_id", "entrypoint_id", "path", "sha256"], "properties": {"suite_id": {"type": "string", "pattern": "^SUITE-[A-Z0-9][A-Z0-9-]{0,31}(?![\\s\\S])", "maxLength": 38}, "entrypoint_id": {"type": "string", "pattern": "^ENTRY-[A-Z0-9][A-Z0-9-]{0,31}(?![\\s\\S])", "maxLength": 38}, "path": {"$ref": "#/$defs/Path"}, "sha256": {"$ref": "#/$defs/Sha"}}}
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "run_id", "run_manifest", "test_results"],
  "properties": {
    "schema": {"const": "evidence-manifest.v1"},
    "run_id": {"$ref": "#/$defs/RunId"},
    "run_manifest": {"allOf": [{"$ref": "#/$defs/ArtifactRef"}, {"properties": {"path": {"const": "run-manifest.json"}}}]},
    "test_results": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"$ref": "#/$defs/ResultRef"}},
    "source_observations": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"$ref": "#/$defs/ObservationRef"}}
  }
}

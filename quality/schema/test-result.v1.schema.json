{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://csswitch.local/schema/test-result.v1.schema.json",
  "title": "CSSwitch run evidence test result v1",
  "oneOf": [
    {"$ref": "#/$defs/Pass"}, {"$ref": "#/$defs/TestFail"}, {"$ref": "#/$defs/HardTimeout"},
    {"$ref": "#/$defs/InfraNoChild"}, {"$ref": "#/$defs/InfraExecuted"}, {"$ref": "#/$defs/Environment"},
    {"$ref": "#/$defs/RealMachine"}, {"$ref": "#/$defs/NotRun"}, {"$ref": "#/$defs/Ignored"},
    {"$ref": "#/$defs/Skipped"}, {"$ref": "#/$defs/ReadinessExhausted"}, {"$ref": "#/$defs/Quarantine"},
    {"$ref": "#/$defs/FlakyRetry"}
  ],
  "$defs": {
    "RunId": {"type": "string", "pattern": "^[0-9a-f]{32}(?![\\s\\S])", "minLength": 32, "maxLength": 32},
    "SuiteId": {"type": "string", "pattern": "^SUITE-[A-Z0-9][A-Z0-9-]{0,31}(?![\\s\\S])", "maxLength": 38},
    "EntrypointId": {"type": "string", "pattern": "^ENTRY-[A-Z0-9][A-Z0-9-]{0,31}(?![\\s\\S])", "maxLength": 38},
    "ReasonCode": {"type": "string", "enum": ["NONE", "ASSERTION_FAILED", "PROCESS_TIMEOUT", "EXEC_FAILED", "ADAPTER_MISSING", "ADAPTER_MALFORMED", "ADAPTER_BINDING_MISMATCH", "EXIT_STATUS_MISMATCH", "ADAPTER_LATE", "OUTPUT_LIMIT", "TOOL_IDENTITY_CHANGED", "ATTEMPT_DUPLICATE", "ENVIRONMENT", "REAL_MACHINE_REQUIRED", "PROFILE_NOT_WIRED", "ADAPTER_REPORTED_IGNORED", "ADAPTER_REPORTED_SKIPPED", "READINESS_TIMEOUT", "QUARANTINED", "READINESS_RETRY_CHANGED"]},
    "Attempt": {"type": "object", "additionalProperties": false, "required": ["attempt_index", "process_exit"], "properties": {"attempt_index": {"type": "integer", "minimum": 0, "maximum": 1}, "process_exit": {"anyOf": [{"type": "integer", "minimum": -255, "maximum": 255}, {"type": "null"}]}}},
    "Attempt0": {"allOf": [{"$ref": "#/$defs/Attempt"}, {"properties": {"attempt_index": {"const": 0}}}]},
    "Attempt1": {"allOf": [{"$ref": "#/$defs/Attempt"}, {"properties": {"attempt_index": {"const": 1}}}]},
    "IntegerAttempt0": {"allOf": [{"$ref": "#/$defs/Attempt0"}, {"properties": {"process_exit": {"type": "integer", "minimum": -255, "maximum": 255}}}]},
    "IntegerAttempt1": {"allOf": [{"$ref": "#/$defs/Attempt1"}, {"properties": {"process_exit": {"type": "integer", "minimum": -255, "maximum": 255}}}]},
    "NullAttempt0": {"allOf": [{"$ref": "#/$defs/Attempt0"}, {"properties": {"process_exit": {"type": "null"}}}]},
    "NullAttempt1": {"allOf": [{"$ref": "#/$defs/Attempt1"}, {"properties": {"process_exit": {"type": "null"}}}]},
    "One": {"type": "array", "minItems": 1, "maxItems": 1, "prefixItems": [{"$ref": "#/$defs/IntegerAttempt0"}], "items": false},
    "Two": {"type": "array", "minItems": 2, "maxItems": 2, "prefixItems": [{"$ref": "#/$defs/IntegerAttempt0"}, {"$ref": "#/$defs/IntegerAttempt1"}], "items": false},
    "HardTimeoutTwo": {"type": "array", "minItems": 2, "maxItems": 2, "prefixItems": [{"allOf": [{"$ref": "#/$defs/IntegerAttempt0"}, {"properties": {"process_exit": {"const": 13}}}]}, {"$ref": "#/$defs/IntegerAttempt1"}], "items": false},
    "Zero": {"type": "array", "minItems": 0, "maxItems": 0, "items": false},
    "Common": {"type": "object", "additionalProperties": false, "required": ["schema", "run_id", "suite_id", "entrypoint_id", "kind", "outcome", "classification", "gate_decision", "reason_code", "runner_exit", "attempt_records"], "properties": {"schema": {"const": "test-result.v1"}, "run_id": {"$ref": "#/$defs/RunId"}, "suite_id": {"$ref": "#/$defs/SuiteId"}, "entrypoint_id": {"$ref": "#/$defs/EntrypointId"}, "kind": {"type": "string", "enum": ["PASS", "TEST_FAIL", "HARD_TIMEOUT", "INFRA", "ENV", "REAL", "NOTRUN", "IGNORED", "SKIPPED", "READINESS_EXHAUSTED", "QUARANTINE", "FLAKY_RETRY"]}, "outcome": {"type": "string"}, "classification": {"type": "string"}, "gate_decision": {"type": "string"}, "reason_code": {"$ref": "#/$defs/ReasonCode"}, "runner_exit": {"type": "integer", "minimum": 0, "maximum": 255}, "attempt_records": {"type": "array", "maxItems": 2, "items": {"$ref": "#/$defs/Attempt"}}}},
    "Pass": {"allOf": [{"$ref": "#/$defs/Common"}, {"properties": {"kind": {"const": "PASS"}, "outcome": {"const": "PASS"}, "classification": {"const": "NONE"}, "gate_decision": {"const": "PASS"}, "reason_code": {"const": "NONE"}, "runner_exit": {"const": 0}, "attempt_records": {"type": "array", "minItems": 1, "maxItems": 1, "prefixItems": [{"allOf": [{"$ref": "#/$defs/IntegerAttempt0"}, {"properties": {"process_exit": {"const": 0}}}]}], "items": false}}}]},
    "TestFail": {"allOf": [{"$ref": "#/$defs/Common"}, {"properties": {"kind": {"const": "TEST_FAIL"}, "outcome": {"const": "FAIL"}, "classification": {"const": "NONE"}, "gate_decision": {"const": "FAIL"}, "reason_code": {"const": "ASSERTION_FAILED"}, "runner_exit": {"const": 10}, "attempt_records": {"type": "array", "minItems": 1, "maxItems": 1, "prefixItems": [{"allOf": [{"$ref": "#/$defs/IntegerAttempt0"}, {"properties": {"process_exit": {"const": 10}}}]}], "items": false}}}]},
    "HardTimeout": {"allOf": [{"$ref": "#/$defs/Common"}, {"properties": {"kind": {"const": "HARD_TIMEOUT"}, "outcome": {"const": "TIMEOUT"}, "classification": {"const": "NONE"}, "gate_decision": {"const": "FAIL"}, "reason_code": {"const": "PROCESS_TIMEOUT"}, "runner_exit": {"const": 13}, "attempt_records": {"oneOf": [{"$ref": "#/$defs/One"}, {"$ref": "#/$defs/HardTimeoutTwo"}]}}}]},
    "InfraNoChild": {"allOf": [{"$ref": "#/$defs/Common"}, {"properties": {"kind": {"const": "INFRA"}, "outcome": {"const": "INFRA_ERROR"}, "classification": {"const": "NONE"}, "gate_decision": {"const": "FAIL"}, "reason_code": {"enum": ["EXEC_FAILED", "TOOL_IDENTITY_CHANGED"]}, "runner_exit": {"const": 12}, "attempt_records": {"oneOf": [{"type": "array", "minItems": 1, "maxItems": 1, "prefixItems": [{"$ref": "#/$defs/NullAttempt0"}], "items": false}, {"type": "array", "minItems": 2, "maxItems": 2, "prefixItems": [{"allOf": [{"$ref": "#/$defs/IntegerAttempt0"}, {"properties": {"process_exit": {"const": 13}}}]}, {"$ref": "#/$defs/NullAttempt1"}], "items": false}]}}}]},
    "InfraExecuted": {"allOf": [{"$ref": "#/$defs/Common"}, {"properties": {"kind": {"const": "INFRA"}, "outcome": {"const": "INFRA_ERROR"}, "classification": {"const": "NONE"}, "gate_decision": {"const": "FAIL"}, "reason_code": {"enum": ["ADAPTER_MISSING", "ADAPTER_MALFORMED", "ADAPTER_BINDING_MISMATCH", "EXIT_STATUS_MISMATCH", "ADAPTER_LATE", "OUTPUT_LIMIT"]}, "runner_exit": {"const": 12}, "attempt_records": {"oneOf": [{"$ref": "#/$defs/One"}, {"type": "array", "minItems": 2, "maxItems": 2, "prefixItems": [{"allOf": [{"$ref": "#/$defs/IntegerAttempt0"}, {"properties": {"process_exit": {"const": 13}}}]}, {"$ref": "#/$defs/IntegerAttempt1"}], "items": false}]}}}]},
    "Environment": {"allOf": [{"$ref": "#/$defs/Common"}, {"properties": {"kind": {"const": "ENV"}, "outcome": {"const": "ENV-BLOCKED"}, "classification": {"const": "NONE"}, "gate_decision": {"const": "BLOCKED"}, "reason_code": {"const": "ENVIRONMENT"}, "runner_exit": {"const": 11}, "attempt_records": {"type": "array", "minItems": 1, "maxItems": 1, "prefixItems": [{"allOf": [{"$ref": "#/$defs/IntegerAttempt0"}, {"properties": {"process_exit": {"const": 11}}}]}], "items": false}}}]},
    "RealMachine": {"allOf": [{"$ref": "#/$defs/Common"}, {"properties": {"kind": {"const": "REAL"}, "outcome": {"const": "NEEDS-REAL-MACHINE"}, "classification": {"const": "NONE"}, "gate_decision": {"const": "BLOCKED"}, "reason_code": {"const": "REAL_MACHINE_REQUIRED"}, "runner_exit": {"const": 11}, "attempt_records": {"type": "array", "minItems": 1, "maxItems": 1, "prefixItems": [{"allOf": [{"$ref": "#/$defs/IntegerAttempt0"}, {"properties": {"process_exit": {"const": 11}}}]}], "items": false}}}]},
    "NotRun": {"allOf": [{"$ref": "#/$defs/Common"}, {"properties": {"kind": {"const": "NOTRUN"}, "outcome": {"const": "NOT-RUN"}, "classification": {"const": "NONE"}, "gate_decision": {"const": "BLOCKED"}, "reason_code": {"const": "PROFILE_NOT_WIRED"}, "runner_exit": {"const": 11}, "attempt_records": {"$ref": "#/$defs/Zero"}}}]},
    "Ignored": {"allOf": [{"$ref": "#/$defs/Common"}, {"properties": {"kind": {"const": "IGNORED"}, "outcome": {"const": "IGNORED"}, "classification": {"const": "NONE"}, "gate_decision": {"const": "BLOCKED"}, "reason_code": {"const": "ADAPTER_REPORTED_IGNORED"}, "runner_exit": {"const": 11}, "attempt_records": {"type": "array", "minItems": 1, "maxItems": 1, "prefixItems": [{"allOf": [{"$ref": "#/$defs/IntegerAttempt0"}, {"properties": {"process_exit": {"const": 11}}}]}], "items": false}}}]},
    "Skipped": {"allOf": [{"$ref": "#/$defs/Common"}, {"properties": {"kind": {"const": "SKIPPED"}, "outcome": {"const": "SKIPPED"}, "classification": {"const": "NONE"}, "gate_decision": {"const": "BLOCKED"}, "reason_code": {"const": "ADAPTER_REPORTED_SKIPPED"}, "runner_exit": {"const": 11}, "attempt_records": {"type": "array", "minItems": 1, "maxItems": 1, "prefixItems": [{"allOf": [{"$ref": "#/$defs/IntegerAttempt0"}, {"properties": {"process_exit": {"const": 11}}}]}], "items": false}}}]},
    "ReadinessExhausted": {"allOf": [{"$ref": "#/$defs/Common"}, {"properties": {"kind": {"const": "READINESS_EXHAUSTED"}, "outcome": {"const": "TIMEOUT"}, "classification": {"const": "READINESS_TIMEOUT"}, "gate_decision": {"const": "BLOCKED"}, "reason_code": {"const": "READINESS_TIMEOUT"}, "runner_exit": {"const": 13}, "attempt_records": {"type": "array", "minItems": 2, "maxItems": 2, "prefixItems": [{"allOf": [{"$ref": "#/$defs/IntegerAttempt0"}, {"properties": {"process_exit": {"const": 13}}}]}, {"allOf": [{"$ref": "#/$defs/IntegerAttempt1"}, {"properties": {"process_exit": {"const": 13}}}]}], "items": false}}}]},
    "Quarantine": {"allOf": [{"$ref": "#/$defs/Common"}, {"properties": {"kind": {"const": "QUARANTINE"}, "outcome": {"const": "NOT-RUN"}, "classification": {"const": "QUARANTINED"}, "gate_decision": {"const": "BLOCKED"}, "reason_code": {"const": "QUARANTINED"}, "runner_exit": {"const": 11}, "attempt_records": {"$ref": "#/$defs/Zero"}}}]},
    "FlakyRetry": {"allOf": [{"$ref": "#/$defs/Common"}, {"properties": {"kind": {"const": "FLAKY_RETRY"}, "outcome": {"const": "FAIL"}, "classification": {"const": "FLAKY"}, "gate_decision": {"const": "BLOCKED"}, "reason_code": {"const": "READINESS_RETRY_CHANGED"}, "runner_exit": {"const": 11}, "attempt_records": {"type": "array", "minItems": 2, "maxItems": 2, "prefixItems": [{"allOf": [{"$ref": "#/$defs/IntegerAttempt0"}, {"properties": {"process_exit": {"const": 13}}}]}, {"allOf": [{"$ref": "#/$defs/IntegerAttempt1"}, {"properties": {"process_exit": {"enum": [0, 10, 11]}}}]}], "items": false}}}]}
  }
}

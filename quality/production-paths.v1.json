{
  "schema": "production-path-policy.v1",
  "version": "v0.8.3",
  "unknown_path_policy": "fail-closed",
  "rename_delete_policy": "fail-closed",
  "paths": [
    {"path": "desktop/", "kind": "production-source", "owner": "desktop", "requirement_ids": ["REQ-083-PATHS", "REQ-083-EVIDENCE"], "required_suite_ids": ["SUITE-QUALITY-INVENTORY", "SUITE-QUALITY-FOCUSED"], "required_gate_ids": ["GATE-QUALITY-PR", "GATE-QUALITY-RELEASE"]},
    {"path": "scripts/", "kind": "build-recipe", "owner": "operations", "requirement_ids": ["REQ-083-PATHS", "REQ-083-EVIDENCE"], "required_suite_ids": ["SUITE-QUALITY-INVENTORY"], "required_gate_ids": ["GATE-QUALITY-PR", "GATE-QUALITY-RELEASE"]},
    {"path": "test/", "kind": "test-runner", "owner": "quality-kernel", "requirement_ids": ["REQ-083-PATHS", "REQ-083-INVENTORY", "REQ-083-FOCUSED"], "required_suite_ids": ["SUITE-QUALITY-INVENTORY", "SUITE-QUALITY-FOCUSED"], "required_gate_ids": ["GATE-QUALITY-META", "GATE-QUALITY-PR", "GATE-QUALITY-RELEASE"]},
    {"path": "quality/", "kind": "quality-machine", "owner": "quality-kernel", "requirement_ids": ["REQ-083-SCHEMA", "REQ-083-REGISTRY", "REQ-083-VALIDATOR", "REQ-083-PATHS"], "required_suite_ids": ["SUITE-QUALITY-METADATA", "SUITE-QUALITY-FOCUSED", "SUITE-QUALITY-INVENTORY"], "required_gate_ids": ["GATE-QUALITY-META", "GATE-QUALITY-PR", "GATE-QUALITY-RELEASE"]},
    {"path": ".github/workflows/", "kind": "release-workflow", "owner": "release", "requirement_ids": ["REQ-083-PATHS", "REQ-083-EVIDENCE"], "required_suite_ids": ["SUITE-QUALITY-IMPACT"], "required_gate_ids": ["GATE-QUALITY-PR", "GATE-QUALITY-RELEASE"]},
    {"path": "desktop/package.json", "kind": "version-source", "owner": "release", "requirement_ids": ["REQ-083-PATHS"], "required_suite_ids": ["SUITE-QUALITY-INVENTORY"], "required_gate_ids": ["GATE-QUALITY-PR", "GATE-QUALITY-RELEASE"]},
    {"path": "desktop/src-tauri/Cargo.toml", "kind": "version-source", "owner": "release", "requirement_ids": ["REQ-083-PATHS"], "required_suite_ids": ["SUITE-QUALITY-INVENTORY", "SUITE-RUST-DESKTOP"], "required_gate_ids": ["GATE-QUALITY-PR", "GATE-QUALITY-RELEASE"]},
    {"path": "desktop/src-tauri/tauri.conf.json", "kind": "version-source", "owner": "release", "requirement_ids": ["REQ-083-PATHS"], "required_suite_ids": ["SUITE-QUALITY-INVENTORY"], "required_gate_ids": ["GATE-QUALITY-PR", "GATE-QUALITY-RELEASE"]},
    {"path": "docs/operations/", "kind": "operational-doc", "owner": "quality-kernel", "requirement_ids": ["REQ-083-EVIDENCE", "REQ-083-PATHS"], "required_suite_ids": ["SUITE-QUALITY-METADATA"], "required_gate_ids": ["GATE-QUALITY-META", "GATE-QUALITY-PR", "GATE-QUALITY-RELEASE"]}
  ],
  "narrative_exemptions": [
    {"path": "docs/", "reason": "Pure narrative and historical docs are evidence context, not production behavior; docs/operations/ is explicitly covered above.", "owner": "quality-kernel"},
    {"path": ".agents/context/", "reason": "Date-indexed context snapshots are not production behavior.", "owner": "quality-kernel"},
    {"path": "docs/audits/", "reason": "Audit documents are historical evidence and explicitly not production behavior.", "owner": "quality-kernel"},
    {"path": "docs/evidence/", "reason": "Evidence reports are narrative/source evidence and do not execute production behavior.", "owner": "quality-kernel"}
  ]
}
